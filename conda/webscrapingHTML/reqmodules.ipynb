    "for i in range(1,10):\n",
    "    res = requests.get(f\"https://books.toscrape.com/catalogue/page-{i}.html\")\n",
    "    with open (f\"htmls/page{i}.html\" , \"w\", encoding=\"utf-8\") as f :\n",
    "        f.write(res.text)\n",
    "        print(f\"downloaded page {i} \")"
   ]
